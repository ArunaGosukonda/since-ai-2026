# ==============================================================================
# Environment Configuration for DNA Digital Security Assistant Frontend
# ==============================================================================
# Copy this file to .env (or .env.local):
#   cp .env.example .env
#
# .env is ignored by the repository's root .gitignore; .env.local by frontend/.gitignore.
# Never commit either.
#
# Every risk, action and advice decision comes from the Python pipeline (dsa.pipeline, run by
# /api/classify). No language-model key is needed. The only third-party calls are ElevenLabs
# speech to text (after the user allows the microphone) and read aloud (our answer text only).
# ==============================================================================

# ElevenLabs API: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Voice ID for TTS (defaults to "YSabzCJMvEHDduIDMdwV")
ELEVENLABS_VOICE_ID=YSabzCJMvEHDduIDMdwV

# Optional: the Python interpreter for /api/classify (default: ../.venv/bin/python, else python3)
# PYTHON_BIN=../.venv/bin/python
