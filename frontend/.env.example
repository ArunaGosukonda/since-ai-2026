# ==============================================================================
# Environment Configuration for DNA Digital Security Assistant Frontend (Turva)
# ==============================================================================
# Copy this file to .env (or .env.local):
#   cp .env.example .env
#
# Both .env and .env.local are gitignored and will never be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (defaults to gemini-3.1-flash-lite). Lite models answer in about 3 s, which live call
# analysis needs; gemini-3.8-flash is much slower. Calls use the Interactions API, which newer
# AI Studio keys (starting "AQ.") require.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional thinking level: minimal (default, fastest) | low | medium | high
# GEMINI_THINKING_LEVEL=minimal

# ------------------------------------------------------------------------------
# 2. ElevenLabs API
# ------------------------------------------------------------------------------
# Get your API key from ElevenLabs: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Voice ID for TTS (defaults to "YSabzCJMvEHDduIDMdwV")
ELEVENLABS_VOICE_ID=YSabzCJMvEHDduIDMdwV

# ------------------------------------------------------------------------------
# 3. Lovable AI Gateway (Optional)
# ------------------------------------------------------------------------------
# Only needed if you are running through Lovable's AI Gateway instead of direct Gemini:
# LOVABLE_API_KEY=your_lovable_api_key_here

